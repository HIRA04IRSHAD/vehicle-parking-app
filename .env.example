# Copy this file to .env and fill in your own values. Never commit .env.
# The app will not start until both are set.
# SECRET_KEY: a random string of at least 32 characters, e.g. the output of
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# ADMIN_PASSWORD: at least 8 characters. Changing it and restarting updates the admin password.
ADMIN_PASSWORD=
# Optional: a Postgres URL for deployment. Leave unset to use local SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Optional: set to 1 when the site is served over HTTPS.
# SESSION_COOKIE_SECURE=1
# Optional: local debugging only.
# FLASK_DEBUG=1
